# ---------------------------------------------------------------------------
# APISentry backend configuration (read from backend/.env; APISENTRY_ prefix).
# All values are optional — the defaults below make the local demo work as-is.
# Copy this file to backend/.env to customize. run_dev.sh does this for you
# (and never overwrites an existing backend/.env).
# ---------------------------------------------------------------------------

# Allowed frontend origin(s) for CORS (comma-separated). Never use "*".
APISENTRY_FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Local demonstration surface: exposes demo fixture tokens via /api/demo/preset
# and enables the reset / full-demo routes. Set to false for a locked-down mode.
APISENTRY_DEMO_MODE=true

# Base URL the engine uses to reach the bundled mock target. Must match the
# backend's own host/port. Requests to local hosts are served in-process.
APISENTRY_MOCK_BASE_URL=http://127.0.0.1:8000/mock/api/v1

# External target policy (opt-in, SSRF-guarded). Keep false for the local lab.
APISENTRY_ALLOW_EXTERNAL_TARGETS=false

# Transport safety limits.
APISENTRY_REQUEST_TIMEOUT_SECONDS=10
APISENTRY_MAX_RESPONSE_BYTES=1000000
APISENTRY_MAX_REQUEST_BYTES=65536

# Bounded in-memory scan history retention.
APISENTRY_HISTORY_LIMIT=100

# ---------------------------------------------------------------------------
# Frontend configuration (read from frontend/.env.local, NOT this file).
# Create frontend/.env.local only if your backend is not at the default below.
#
#   NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# ---------------------------------------------------------------------------
